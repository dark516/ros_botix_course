<?xml version="1.0"?>
<package format="3">
  <name>botix_navigation</name>
  <version>0.1.0</version>
  <description>SLAM Toolbox and Navigation2 bringup for the Botix rover.</description>
  <maintainer email="sashakulagin2007@gmail.com">dark516</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>botix_driver</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lidar_filter</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
